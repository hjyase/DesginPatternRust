# Cargo.lock （库项目建议忽略，二进制项目建议提交）
Cargo.bak
.cargo/

# 环境变量文件
.env
.env.local
.env.*

# 编辑器/IDE 配置文件（VS Code）
.vscode/
.idea/
*.swp
*.swo
.DS_Store  # Mac 系统隐藏文件

# 日志/临时文件
*.log
tmp/
temp/

# 测试/覆盖率文件
coverage/
*.profraw

# 构建脚本生成的文件
build/
out/